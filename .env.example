AEGIS_DATA_DIR=
AEGIS_DB_PATH=
AEGIS_USER_AGENT=AEGIS-student-research/0.1 (set-your-contact)
NCEI_TOKEN=
OSRM_BASE_URL=https://router.project-osrm.org
# Optional local sensor gateway. Generate a secret of at least 32 characters.
# Keep it on the server/gateway; never include it in frontend code or Git.
AEGIS_SENSOR_INGEST_TOKEN=
# Optional topic selection only. No model is downloaded or called by default.
# AEGIS_ASSISTANT_OLLAMA_ENABLED=1
# AEGIS_ASSISTANT_OLLAMA_MODEL=<explicitly installed model:tag>
# AEGIS_ASSISTANT_OLLAMA_URL=http://127.0.0.1:11434
# Isolated rehearsal variables are set by scripts/start_rehearsal.py.
# Keep them unset in the operator environment; a partial configuration is rejected.
# AEGIS_REHEARSAL_ID=<launcher-generated canonical UUID>
# AEGIS_OFFLINE_DEMO=1

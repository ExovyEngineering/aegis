# Keep source diffs consistent between Windows and other development systems.
* text=auto eol=lf
*.png binary
*.parquet binary
*.xlsx binary
*.pdf binary
*.cmd text eol=crlf

# Provider responses and audit evidence retain their exact stored bytes.
data/external/** -text
data/fixtures/** -text
data/manifests/** -text

# Hashed analytic exports, report evidence and handbook inputs must survive
# Windows/Linux checkouts byte for byte; newline conversion invalidates lineage.
data/processed/** -text
reports/** -text
docs/** -text
notebooks/** -text
requirements-notebooks.txt -text
